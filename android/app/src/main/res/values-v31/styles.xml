<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/vrcn_bg</item>
        <!-- Android 12+ falls back to the launching activity's icon. Each launcher
             alias already provides its selected holiday artwork before JS starts.
             Direct MainActivity launches use the application's new standard icon. -->
        <item name="windowSplashScreenAnimatedIcon">@null</item>
        <item name="android:windowSplashScreenAnimatedIcon">@null</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
