<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:enabled="true"
            android:exported="true">
        </activity>

        <!-- Aliases change only the launcher artwork; MainActivity remains enabled. -->
        <activity-alias android:name=".launcher.Standard" android:targetActivity=".MainActivity"
            android:enabled="true" android:exported="true" android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Valentine" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_valentine"
            android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.WomensDay" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_womens_day"
            android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.StPatrick" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_st_patrick"
            android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Easter" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_easter"
            android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.EarthDay" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_earth_day"
            android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Halloween" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_halloween"
            android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".launcher.Christmas" android:targetActivity=".MainActivity"
            android:enabled="false" android:exported="true" android:icon="@mipmap/ic_launcher_christmas"
            android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

</manifest>
